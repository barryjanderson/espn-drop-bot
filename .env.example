# Copy to .env and fill in. Never commit .env.

# From your ESPN league URL (e.g. leagueId=123456)
LEAGUE_ID=

# DevTools → Application → Cookies → fantasy.espn.com (while logged in)
ESPN_S2=
SWID=

# Optional, defaults to 2026
ESPN_SEASON=2026

# Optional: league JSON API base (default = lm-api-reads; do not use fantasy.espn.com/apis here)
# ESPN_API_BASE=https://lm-api-reads.fantasy.espn.com/apis/v3/games

# Transaction API: x-fantasy-filter (default on) — only FREEAGENT / WAIVER / WAIVER_ERROR, not LINEUP noise
# ESPN_TRANSACTION_FILTER=0
# ESPN_TRANSACTION_FILTER_TYPES=FREEAGENT,WAIVER,TRADE_ACCEPT
# Optional: limit mTransactions2 to one scoring period (integer)
# ESPN_SCORING_PERIOD_ID=7

# Discord channel webhook (Server Settings → Integrations → Webhooks)
DISCORD_WEBHOOK_URL=

# Optional (drop_monitor.py)
# POLL_INTERVAL_SEC=300
# STATE_PATH=seen_transactions.json
# First run with empty state: record existing drops without notifying (recommended)
# SEED_ON_FIRST_RUN=1

# --- Vercel + GitHub Actions (cloud monitor) ---
# Upstash Redis: REST URL + token from the Upstash console
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Optional Redis key for seen transaction JSON (default: espn_drop_bot:seen_json)
# UPSTASH_SEEN_KEY=espn_drop_bot:seen_json
# Shared secret: set the same value in Vercel env and GitHub secret CRON_SECRET
# CRON_SECRET=
# Optional GitHub Actions only: if Vercel Deployment Protection is on, add the bypass
# token here as repo secret VERCEL_BYPASS_TOKEN (not needed on Vercel itself)
# Tighter ESPN timeout on Hobby (seconds); optional, default 8 in api/monitor.py
# ESPN_FETCH_TIMEOUT_SEC=8
